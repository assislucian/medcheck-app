# MedCheck - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais

# === CONFIGURAÇÕES DO BANCO DE DADOS ===
# Para desenvolvimento: sqlite:///./medicos.db
# Para produção: postgresql://user:password@host:port/database_name
DATABASE_URL=sqlite:///./medicos.db

# === AUTENTICAÇÃO JWT ===
# Use uma chave secreta forte e única em produção
# Gere com: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === CONFIGURAÇÕES DE SEGURANÇA ===
# JWT Secret - diferente da SECRET_KEY para tokens específicos
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-jwt-secret-here-change-in-production

# === CORS e FRONTEND ===
# URLs permitidas para CORS (separadas por vírgula)
FRONTEND_ORIGINS=http://localhost:8080,http://localhost:3000

# === CONFIGURAÇÕES DE AMBIENTE ===
# development | production | testing
ENV=development
DEBUG=true

# === CONFIGURAÇÕES OPCIONAIS ===
# Para testes ou demos - permitir pular autenticação
SKIP_AUTH=false

# Para desenvolvimento - CRM fixo para testes
CRM_LOGADO=6091

# === LOGS ===
# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# === RATE LIMITING ===
# Requests por minuto por IP
RATE_LIMIT_PER_MINUTE=60

# === UPLOADS ===
# Tamanho máximo de arquivo em MB
MAX_FILE_SIZE_MB=50

# === EMAILS (OPCIONAL) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@medcheck.com

# === MONITORAMENTO (OPCIONAL) ===
# SENTRY_DSN=your-sentry-dsn-here
# PROMETHEUS_ENABLED=false