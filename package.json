{
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@prisma/client": "^6.9.0",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-tooltip": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.507.0",
    "pdfjs-dist": "^5.2.133",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "jscodeshift": "^17.3.0",
    "prisma": "^6.9.0",
    "vitest": "^2.1.9",
    "pytest": "^8.0.0",
    "pytest-asyncio": "^0.24.0",
    "pytest-cov": "^5.0.0",
    "httpx": "^0.27.0",
    "pytest-mock": "^3.14.0",
    "black": "^24.3.0",
    "flake8": "^7.0.0",
    "mypy": "^1.9.0",
    "isort": "^5.13.0",
    "bandit": "^1.7.7",
    "safety": "^3.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,html}": "grep -qE \"bg-(white|black|gray-(50|100|900))\" && (echo '🚫 Evite cores fixas; use tokens surface-*'; exit 1) || true",
    "*.py": [
      "black",
      "isort",
      "flake8",
      "mypy"
    ]
  },
  "engines": {
    "node": ">=18 <24"
  },
  "scripts": {
    "start": "node dist/index.js",
    "prisma": "prisma generate",
    "test": "pytest tests/ -v --cov=src --cov-report=html --cov-report=term",
    "test:unit": "pytest tests/unit/ -v",
    "test:integration": "pytest tests/integration/ -v",
    "test:e2e": "pytest tests/e2e/ -v",
    "test:security": "bandit -r src/ && safety check",
    "test:coverage": "pytest --cov=src --cov-report=html --cov-report=term --cov-fail-under=80",
    "lint": "black src/ tests/ && isort src/ tests/ && flake8 src/ tests/ && mypy src/",
    "lint:check": "black --check src/ tests/ && isort --check-only src/ tests/ && flake8 src/ tests/ && mypy src/",
    "format": "black src/ tests/ && isort src/ tests/",
    "ci": "npm run lint:check && npm run test:security && npm run test:coverage"
  }
}
