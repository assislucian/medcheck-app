{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm ci",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://medcheck-backend.onrender.com/api/$1"
    },
    {
      "source": "/token",
      "destination": "https://medcheck-backend.onrender.com/token"
    },
    {
      "source": "/health",
      "destination": "https://medcheck-backend.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
